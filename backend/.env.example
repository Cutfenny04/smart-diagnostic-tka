PORT=5000

# Ambil dari dashboard Supabase: Settings > Database > Connection string > URI
# (ganti [YOUR-PASSWORD] dengan password database project-mu)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Ambil dari dashboard Supabase: Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=ganti_dengan_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_service_role_secret_key
